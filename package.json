{
  "name": "maplibre-gl-svg-sprite",
  "version": "0.1.0",
  "type": "module",
  "description": "Render SVGs into PNG sprites + JSON metadata entirely in the browser (TypeScript)",
  "license": "MIT",
  "author": "maplibre-gl-svg-sprite contributors",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/opendataland"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opendataland/maplibre-gl-svg-sprite.git"
  },
  "bugs": {
    "url": "https://github.com/opendataland/maplibre-gl-svg-sprite/issues"
  },
  "homepage": "https://github.com/opendataland/maplibre-gl-svg-sprite#readme",
  "keywords": [
    "sprite",
    "svg",
    "canvas",
    "json",
    "browser",
    "typescript",
    "maplibre",
    "mapbox",
    "gl-style",
    "sprites",
    "sprite-sheet",
    "icon-generation"
  ],
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "docs": "typedoc"
  },
  "sideEffects": false,
  "peerDependencies": {
    "maplibre-gl": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^19.0.2",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
